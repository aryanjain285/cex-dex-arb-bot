# =================================
# |          REQUIRED             |
# =================================
# Private key for the DEX trading wallet.
# This is a hard requirement: config loading raises without it, even for
# read-only commands such as `check-dex-balance`.
# EXTREMELY SENSITIVE - use a fresh hot wallet dedicated solely to this bot,
# funded with the minimum needed to operate.
DEX_WALLET_PRIVATE_KEY="0x..."

# =================================
# |     RPC & Network Settings    |
# =================================
# At least one RPC URL is required. Empty values are dropped at load time,
# and a chain with no URL is unsupported at runtime - so if you configure a
# pair on `arbitrum` without ARBITRUM_RPC_URL, every quote for it will fail.
ETH_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"
ARBITRUM_RPC_URL="https://arb-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY"
BASE_RPC_URL="https://mainnet.base.org"
BSC_RPC_URL="https://bsc-dataseed.binance.org/"

# =================================
# |       Exchange Settings       |
# =================================
# CEX API credentials. Grant spot trading only - disable withdrawals.
# Missing values only log a warning, but private endpoints and the user data
# stream will not work without them.
BINANCE_API_KEY="YOUR_BINANCE_API_KEY"
BINANCE_API_SECRET="YOUR_BINANCE_API_SECRET"

# =================================
# |      Discovery Pipeline       |
# =================================
# Required by `python -m src.scanner.token_address_builder`.
# Sent as the x-cg-pro-api-key header; the script exits if it is empty.
COINGECKO_API_KEY=""

# Required by `python src/scanner/dex_pool_scanner.py`.
# Get one from https://thegraph.com/studio/ - the free tier covers this workload.
THEGRAPH_API_KEY=""

# =================================
# |   Observability & Alerting    |
# =================================
# (Optional) Webhook URL for important alerts.
# NOTE: declared here but not yet read anywhere in the code.
ALERT_WEBHOOK_URL="https://hooks.slack.com/services/..."
