# Secrets
.env

# Scratch / local-only
other/
.claude/settings.local.json

# Python
__pycache__/
*.pyc
*.pyo
*.egg-info/
.venv/
venv/
venv_uniswap_swapper/

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Generated data.
# Scoped to data/ so contract ABIs and other required JSON stay tracked.
data/*.json
data/*.yaml
!data/target_pools_Dex.json
!data/.gitkeep

# The evaluation store and its SQLite sidecars. These were tracked by mistake for
# several commits, which meant a clone shipped MY test-run data: an operator's first
# `analyse` would have reported my numbers under my run_ids, which is exactly the
# stale-data-producing-stale-decisions failure the audit trail exists to prevent.
# The -wal file reached 4 MB of binary churn.
data/*.sqlite3
data/*.sqlite3-shm
data/*.sqlite3-wal

# Node
node_modules/
dashboard/backend/node_modules/
dashboard/frontend/node_modules/
dashboard/frontend/build/

# Research environment: public endpoints only, but keep it out of the repo so
# nobody's local edits (a paid RPC key, say) get committed.
.env.research
